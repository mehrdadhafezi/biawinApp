# Copy to .env for local Backend-on-Windows-host development. Run
# `pnpm dev:infra` first (docker-compose.dev-infra.yml) to provide these
# services — see docs/05-development-guide.md.
#
# These are HOST-side values: 127.0.0.1, not "localhost" (Windows sometimes
# resolves "localhost" to a different interface than a raw loopback IP, which
# is one of two things that caused the P1000 incident — see
# docs/05-development-guide.md "Root Cause: P1000"), and port 55433 for
# Postgres specifically, NOT 5432. docker-compose.dev-infra.yml deliberately
# publishes Postgres on 55433 because a native PostgreSQL install already
# listening on 5432 on the Windows host will silently swallow connections
# meant for the container — Prisma then fails with P1000 "Authentication
# failed" that looks like a credential bug but is actually a port collision.
# If you're running the FULL containerized stack instead (docker-compose.yml,
# `docker compose up -d`), backend/web use container-internal DNS names
# (postgres:5432, redis:6379, minio:9000) — never mix the two sets of values.
#
# Production values (biawin.ir) are illustrative ONLY — never put real
# production secrets in this file or in docker-compose.yml. See
# docs/04-deployment.md "Environments" and docs/07-security.md "Secret Management".

NODE_ENV=development
PORT=4000

# --- Database (host: port 55433, NOT 5432 — see note above) -----------------
DATABASE_URL="postgresql://biawin:biawin@127.0.0.1:55433/biawin?schema=public"

# --- Redis (OTP, session, cache, rate-limit, queues) -------------------------
REDIS_URL="redis://127.0.0.1:6379"

# --- Auth ---------------------------------------------------------------------
JWT_ACCESS_SECRET="dev-access-secret-change-me-please"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please"
JWT_REFRESH_TTL_DAYS=30

OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

SIGNUP_TOKEN_TTL_SECONDS=600

# --- Object Storage (MinIO in dev, any S3-compatible provider in prod) -------
STORAGE_ENDPOINT="http://127.0.0.1:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="biawin"
STORAGE_SECRET_KEY="biawin12345"
STORAGE_BUCKET="biawin-dev"
STORAGE_FORCE_PATH_STYLE=true

# --- CORS ---------------------------------------------------------------------
# Development: localhost:3000. Production: https://biawin.ir (comma-separate
# for multiple origins, e.g. when admin.biawin.ir also calls this API).
CORS_ORIGINS="http://localhost:3000"

# --- SMS provider (notifications module, docs/07-security.md) ---------------
# "mock" (default) just logs — safe for dev/CI with no real credentials.
SMS_PROVIDER=mock
# FARAZ_API_URL=
# FARAZ_USERNAME=
# FARAZ_PASSWORD=
# FARAZ_SENDER=

# --- Payment provider (payments module, architecture only — not yet wired
# into any business flow) ------------------------------------------------------
PAYMENT_PROVIDER=zibal
# ZIBAL_MERCHANT_ID=
# ZARINPAL_MERCHANT_ID=
