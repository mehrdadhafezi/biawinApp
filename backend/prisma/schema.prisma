// Prisma schema for Biawin — Foundation models only.
//
// Scope: the 19 core models requested for the Production Foundation, plus one
// infrastructure-only addition (RefreshToken, needed to implement the JWT
// refresh-token strategy from docs/07-security.md). No business-logic
// migrations beyond this structural model are applied yet — computed fields,
// full validation rules, and additional entities (missions, chat history,
// news, addresses, ...) from docs/01-prototype-analysis.md §5 are added when
// their owning module is built out as a Feature.
//
// See docs/02-database.md for the purpose/relations/indexes of every table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
  deleted
}

/// Single value today (unified login/signup flow — see docs/03-api.md). Kept as
/// an enum (not dropped) so a future purpose (e.g. "two_factor", "phone_change")
/// can be added without another migration.
enum OtpPurpose {
  auth
}

enum MembershipCardKind {
  earn
  core
  reward
}

enum SubscriptionTier {
  start
  plus
  family
  prime
  gift
  travel
  lifestyle
  organizational
}

enum MembershipStatus {
  active
  pending
  special
  expired
}

enum WalletKind {
  main
  reward
}

enum WalletTxType {
  topup
  spend
  refund
  gateway_settlement
}

enum CreditLineStatus {
  active
  suspended
  closed
}

enum InstallmentStatus {
  active
  completed
  defaulted
  cancelled
}

enum PurchaseMethod {
  credit
  installment
  cash
  free
}

enum OrderStatus {
  pending
  processing
  awaiting_payment
  paid
  delivered
  cancelled
}

enum PaymentProvider {
  wallet
  gateway
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum RewardClaimStatus {
  pending_payment
  confirmed
  cancelled
}

enum NotificationType {
  order_status
  promotion
  system
  security
}

enum AdvisorPersonaKey {
  viana
  winyar
  arvin
}

/// Stage 5.15.1 ADR §4 — a small, closed set of roles, not a granular
/// permission matrix (see docs/admin-architecture-decision-record.md §4 for
/// why). SUPER_ADMIN can do everything; CONTENT_EDITOR edits content but not
/// billing/user data once Admin scope grows past Home; SUPPORT_VIEWER is
/// read-only. New roles are additive enum values, not a redesign.
enum AdminRole {
  SUPER_ADMIN
  CONTENT_EDITOR
  SUPPORT_VIEWER
}

/// Started minimal in Stage 5.16 (login/logout only). Stage 5.18 adds
/// `CREATE`/`DELETE` for the first real admin-managed content controller
/// (Media Library) — `UPDATE`/`REORDER` are still not added because nothing
/// in this codebase performs them yet; add them the same way, against a
/// real call site, when something does (see
/// docs/admin-architecture-decision-record.md §8).
enum AdminAuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  CREATE
  DELETE
}

// ---------------------------------------------------------------------------
// Auth / Identity
// ---------------------------------------------------------------------------

/// No email/password anywhere on this model — phone is the sole login identifier
/// (see docs/03-api.md). `subscriptionCode` entered at signup is intentionally
/// NOT stored here: it is handed off to the membership domain
/// (`MembershipService.registerSubscriptionCode`) which owns real redemption/
/// activation logic. Terms/consent acceptance is not modeled yet — a future
/// `UserConsent` model will own that (see docs/07-security.md).
model User {
  id               String     @id @default(uuid())
  phone            String     @unique
  phoneVerifiedAt  DateTime?
  inviteCode       String     @unique
  referredByCode   String?
  twoFactorEnabled Boolean    @default(false)
  status           UserStatus @default(active)

  profile           Profile?
  memberships       Membership[]
  wallets           Wallet[]
  creditLines       CreditLine[]
  installments      Installment[]
  orders            Order[]
  rewardClaims      RewardClaim[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  phoneVerifications PhoneVerification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  email       String?
  nationalId  String?
  birthDate   DateTime?
  avatarKey   String? // object key in Storage, not a public URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

/// Persists OTP challenges for login/signup/password-reset flows.
/// `userId` is nullable because a signup challenge is issued before the User exists.
model PhoneVerification {
  id                String     @id @default(uuid())
  phone             String
  purpose           OtpPurpose
  codeHash          String
  expiresAt         DateTime
  attemptsRemaining Int        @default(5)
  consumedAt        DateTime?
  userId            String?
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@map("phone_verifications")
}

/// Opaque refresh-token records (the JWT itself is never persisted — only a hash
/// of the refresh token, so a DB leak can't be used to mint sessions).
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Membership / Subscriptions
// ---------------------------------------------------------------------------

/// Catalog of membership cards (admin-managed content) — the "subscriptions" module.
model MembershipPlan {
  id                     String              @id @default(uuid())
  kind                   MembershipCardKind
  tier                   SubscriptionTier?
  title                  String
  kicker                 String
  shortDescription       String
  description            String
  level                  String
  creditLabel            String
  durationLabel          String
  priceLabel             String
  accentColor            String
  deepColor              String
  activationActionLabel  String
  benefits               Json // MembershipBenefit[]
  terms                  Json // string[]
  sortOrder              Int                 @default(0)
  active                 Boolean             @default(true)

  accessibleCategories Category[]   @relation("PlanCategories")
  memberships          Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("membership_plans")
}

/// A user's activation of a membership plan — the "membership" module.
model Membership {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId       String
  plan         MembershipPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  status       MembershipStatus  @default(pending)
  activatedAt  DateTime?
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Wallet / Credit / Installments
// ---------------------------------------------------------------------------

model Wallet {
  id      String     @id @default(uuid())
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind    WalletKind
  /// Balance in Rial (integer, never a float — see docs/02-database.md).
  balance Int        @default(0)

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind])
  @@map("wallets")
}

model WalletTransaction {
  id                    String       @id @default(uuid())
  walletId              String
  wallet                Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type                  WalletTxType
  amount                Int
  /// Snapshot of the wallet balance immediately after this transaction, for auditability.
  balanceAfter          Int
  relatedOrderId        String?
  relatedRewardClaimId  String?
  description           String

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model CreditLine {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  limitAmount Int
  usedAmount  Int               @default(0)
  status      CreditLineStatus  @default(active)
  expiresAt   DateTime?

  usages CreditUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("credit_lines")
}

model CreditUsage {
  id           String     @id @default(uuid())
  creditLineId String
  creditLine   CreditLine @relation(fields: [creditLineId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount       Int
  description  String

  createdAt DateTime @default(now())

  @@index([creditLineId, createdAt])
  @@map("credit_usages")
}

model Installment {
  id            String            @id @default(uuid())
  orderId       String            @unique
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalMonths   Int
  monthlyAmount Int
  paidCount     Int               @default(0)
  status        InstallmentStatus @default(active)
  nextDueDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("installments")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  imageKey    String?
  keywords    Json // string[]
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)

  services   Service[]
  plans      MembershipPlan[] @relation("PlanCategories")
  orbitItems OrbitItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

// Landing page Orbit bubbles — Admin-managed replacement for the frozen
// static catalog (see docs/11-orbit-asset-system.md). `positionConfig` /
// `animationConfig` mirror the frontend's OrbitItemPosition/OrbitItemAnimation
// shape verbatim (kept as Json so Admin can tune them without a migration).
model OrbitItem {
  id         String   @id @default(uuid())
  slug       String   @unique
  title      String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  imageKey   String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)

  positionConfig  Json // { leftPercent: number, topPercent: number }
  animationConfig Json // { variant: "a" | "b" | "c" | "d", delaySeconds: number }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orbit_items")
}

model Merchant {
  id          String  @id @default(uuid())
  name        String
  description String?
  logoKey     String?
  active      Boolean @default(true)

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("merchants")
}

model Service {
  id                     String   @id @default(uuid())
  categoryId             String
  category               Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  merchantId             String?
  merchant               Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  title                  String
  groupLabel             String
  subtitle               String
  badge                  String
  /// Emoji/symbol shown before a real product photo exists (matches the
  /// prototype's icon-per-product pattern) — distinct from `imageKey`, which
  /// is a Storage object key for an actual uploaded image.
  icon                   String?
  imageKey               String?
  priceFrom              Int?
  priceLabel             String?
  availableMethods       Json // PurchaseMethod[]
  installmentMinMonths   Int?
  installmentMaxMonths   Int?
  creditMultiplierLabel  String?
  benefits               Json // string[]
  galleryKeys            Json // string[]
  faq                    Json // {question, answer}[]
  tags                   Json // string[]
  active                 Boolean  @default(true)

  orders       Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("services")
}

// ---------------------------------------------------------------------------
// Orders / Payments
// ---------------------------------------------------------------------------

model Order {
  id            String         @id @default(uuid())
  orderNumber   String         @unique
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  serviceId     String
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  method        PurchaseMethod
  amount        Int
  status        OrderStatus    @default(pending)

  installment  Installment?
  creditUsages CreditUsage[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("orders")
}

model Payment {
  id            String          @id @default(uuid())
  orderId       String?
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rewardClaimId String?
  rewardClaim   RewardClaim?    @relation(fields: [rewardClaimId], references: [id], onDelete: SetNull)
  provider      PaymentProvider
  amount        Int
  status        PaymentStatus   @default(pending)
  gatewayRef    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([rewardClaimId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Rewards
// ---------------------------------------------------------------------------

model Reward {
  id          String  @id @default(uuid())
  title       String
  imageKey    String?
  cost        Int
  description String
  active      Boolean @default(true)

  claims RewardClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rewards")
}

model RewardClaim {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  rewardId        String
  reward          Reward             @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  cost            Int
  paidFromWallet  Int
  paidFromGateway Int
  status          RewardClaimStatus  @default(pending_payment)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("reward_claims")
}

// ---------------------------------------------------------------------------
// Notifications / Advisor
// ---------------------------------------------------------------------------

model Notification {
  id     String            @id @default(uuid())
  userId String
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String
  body   String
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

/// Catalog of AI advisor personas (وینا / وین‌یاد / آروین). Chat history and
/// live LLM wiring are out of scope for this Foundation — see
/// docs/01-prototype-analysis.md §7.
model AdvisorPersona {
  id            String            @id @default(uuid())
  key           AdvisorPersonaKey @unique
  name          String
  role          String
  style         String
  bestFor       String
  focus         String
  quote         String
  traits        Json // string[]
  avatarKey     String?
  /// Server-only system prompt used once this persona is wired to a real LLM.
  systemPrompt  String
  active        Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("advisor_personas")
}

// ---------------------------------------------------------------------------
// Admin (Stage 5.16 — docs/admin-architecture-decision-record.md)
// ---------------------------------------------------------------------------

/// Deliberately separate from `User` (ADR §3): admin access is
/// staff-provisioned, never self-service, so it cannot share the phone+OTP
/// self-registration model `User` is built around. Email+password, not OTP —
/// a small internal population shouldn't depend on carrier SMS delivery to
/// act during an incident. `failedLoginAttempts`/`lockedUntil` implement
/// ADR §12.5's login lockout, the same shape `PhoneVerification.attemptsRemaining`
/// already uses for OTP, applied to password attempts instead.
model AdminUser {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  fullName            String
  role                AdminRole @default(CONTENT_EDITOR)
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  refreshTokens AdminRefreshToken[]
  auditLogs     AdminAuditLog[]
  uploadedMedia MediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

/// Mirrors `RefreshToken` exactly (opaque token, only its hash persisted) —
/// a deliberately separate table, not a shared one, per ADR §3 "do not reuse
/// customer authentication": an admin session must never be revocable (or
/// readable) through the customer refresh-token code path, and vice versa.
model AdminRefreshToken {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([adminUserId])
  @@map("admin_refresh_tokens")
}

/// Append-only (ADR §8) — no update/delete surface is ever exposed for this
/// model. `adminUserId` is nullable + `SetNull` on delete (ADR §5's exact
/// FK-deletion policy for admin-authored content, applied here too): a
/// deactivated/removed AdminUser's history must survive them, and a
/// LOGIN_FAILED attempt against an email that never matched any AdminUser
/// has no id to attach at all (the attempted email is kept in `afterJson`
/// instead, never as a second identity column).
model AdminAuditLog {
  id           String            @id @default(uuid())
  adminUserId  String?
  adminUser    AdminUser?        @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action       AdminAuditAction
  resourceType String
  resourceId   String?
  beforeJson   Json?
  afterJson    Json?
  ip           String?
  userAgent    String?

  createdAt DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("admin_audit_logs")
}

// ---------------------------------------------------------------------------
// Media Library (Stage 5.18 — docs/admin-architecture-decision-record.md §6,
// docs/home-admin-contract.md §5)
// ---------------------------------------------------------------------------

/// The central, content-type-agnostic media catalog every future
/// admin-managed image field (Home banners, News, Orbit, ...) is meant to
/// reference by id — not built by any of those yet (explicitly out of scope
/// this stage), but the model is shaped so referencing it later is a plain
/// FK addition, not a redesign. `key` follows the exact `imageKey` pattern
/// already used everywhere else (`Category.imageKey`, `OrbitItem.imageKey`,
/// `MembershipPlan.imageKey`) — an object-storage key, resolved to a public
/// URL by the static-bridge pattern ADR §6 confirms project-wide, never a
/// raw stored URL. `width`/`height` are extracted server-side at upload time
/// (dependency-free header parsing — see media/utils/image-metadata.util.ts)
/// so consumers never need to re-decode the file just to lay out a preview.
/// `deletedAt` (not a hard delete) is this stage's "delete safety
/// mechanism": once a real content type starts referencing `MediaAsset.id`,
/// a hard delete could silently break live content with no recovery path;
/// nothing references this table yet, but the mechanism is built the safe
/// way from the start rather than retrofitted once something does.
model MediaAsset {
  id         String    @id @default(uuid())
  fileName   String
  key        String    @unique
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  altText    String?
  active     Boolean   @default(true)
  deletedAt  DateTime?

  uploadedBy      String?
  uploadedByAdmin AdminUser? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, createdAt])
  @@map("media_assets")
}
