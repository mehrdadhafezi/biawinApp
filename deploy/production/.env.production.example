# Copy to deploy/production/.env.production on the SERVER ONLY. Never commit
# the real file — it is gitignored (see .gitignore's `.env*` / `!.env.example`
# rule). Fill in real random secrets on the server itself; this file only
# holds placeholders and structure. NEVER reuse any staging secret here —
# every value below must be freshly generated for production.
#
# Generate strong random secrets with, e.g.:
#   openssl rand -base64 48

NODE_ENV=production
PORT=4000

# --- Database (internal Docker network: service name, NOT a host port) ------
POSTGRES_USER=biawin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
POSTGRES_DB=biawin_production
DATABASE_URL="postgresql://biawin:REPLACE_WITH_RANDOM_SECRET@postgres:5432/biawin_production?schema=public"

# --- Redis --------------------------------------------------------------------
REDIS_URL="redis://redis:6379"

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_REFRESH_TTL_DAYS=30

OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

SIGNUP_TOKEN_TTL_SECONDS=600

# ##############################################################################
# # MUST BE false IN PRODUCTION. This is the staging-only fixed-phone OTP
# # bypass (09121111111 / 123456). The code default (env.validation.ts) is
# # already `false` if this line is omitted entirely, but it is set
# # EXPLICITLY here, not omitted, specifically so a reviewer scanning this
# # file sees an unambiguous "false", not an absence that could be
# # misread as "not configured yet". Never copy `true` from a staging
# # .env file into this one.
# ##############################################################################
STAGING_TEST_AUTH=false

# --- Admin auth (Stage 5.16, docs/admin-architecture-decision-record.md) ----
# REQUIRED — the backend fails to boot without these two (no default,
# min 16 chars). Deliberately separate secrets from JWT_ACCESS_SECRET/
# JWT_REFRESH_SECRET above — never reuse the customer ones here. Also never
# reuse staging's ADMIN_JWT_* values.
ADMIN_JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET
ADMIN_JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_SECRET
ADMIN_JWT_ACCESS_TTL=10m
ADMIN_JWT_REFRESH_TTL_DAYS=7
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15

# First SUPER_ADMIN, created only by the compiled seed script (which
# deploy.sh runs every deploy). Optional in the schema, but without these
# set, no admin account exists on this environment at all and Admin Portal
# login is impossible. Use a real production email and a freshly generated
# password — change the password immediately after first login regardless.
ADMIN_SEED_EMAIL=admin@biawin.ir
ADMIN_SEED_PASSWORD=REPLACE_WITH_RANDOM_SECRET
ADMIN_SEED_FULL_NAME="Biawin Admin"

# --- Object Storage (MinIO) -------------------------------------------------
# NOTE: there is no STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY here on purpose —
# docker-compose.production.yml's `backend.environment` derives both
# directly from MINIO_ROOT_USER/MINIO_ROOT_PASSWORD below, the same two
# variables `minio`/`minio-init` use. This is not optional hygiene: adding
# STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY here independently is exactly what
# broke staging's first media migration attempt with SignatureDoesNotMatch
# (Stage 5.22) — see docs/08-staging-deployment.md "MinIO/S3 credential
# consistency" for the full incident. Only fill in MINIO_ROOT_USER/
# MINIO_ROOT_PASSWORD below.
STORAGE_ENDPOINT="http://minio:9000"
STORAGE_REGION=us-east-1
MINIO_ROOT_USER=biawin
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_SECRET
STORAGE_BUCKET=biawin-production
STORAGE_FORCE_PATH_STYLE=true

# --- Media Library (Stage 5.18) — optional, defaults to 5MB if unset --------
MEDIA_MAX_FILE_SIZE_BYTES=5242880

# --- Public asset base URL (Stage 5.21) -------------------------------------
# REQUIRED to be set correctly here — the code default (localhost:4000) is
# only correct for local dev. Every Home CMS image URL is built from this
# value; leaving it unset in production would serve images pointing at
# "localhost" to real customers, appearing broken in every browser.
PUBLIC_API_ORIGIN=https://api.biawin.ir

# --- CORS -----------------------------------------------------------------
# Both frontend origins allowed to call this API — the real Customer App AND
# the real Admin Portal. The Admin Portal's own auth remains fully isolated
# from the customer one; this only controls which browser origins may issue
# requests at all.
CORS_ORIGINS="https://REPLACE_WITH_CONFIRMED_CUSTOMER_DOMAIN,https://admin.biawin.ir"

# --- SMS provider -------------------------------------------------------------
# ##############################################################################
# # BLOCKING PREREQUISITE FOR CUSTOMER CUTOVER — not something this stage
# # configures. As of this preflight, this codebase's only credentialed SMS
# # path is FARAZ_* (see backend/.env.example / docker-compose.yml), and no
# # real account has been credentialed yet anywhere in this repo's history.
# # With SMS_PROVIDER=mock, real customers CANNOT complete OTP login and
# # CANNOT reach the authenticated Home CMS experience at all — Admin/CMS
# # management still works (it doesn't depend on customer SMS), but the
# # Customer-facing release is not actually usable by real users until this
# # is resolved. Do not flip Customer DNS/cutover with this still on mock.
# ##############################################################################
SMS_PROVIDER=mock
# FARAZ_API_URL=
# FARAZ_USERNAME=
# FARAZ_PASSWORD=
# FARAZ_SENDER=

# --- Payment provider — architecture only; no real transactions without
# credentials supplied later by the project owner (unrelated to the Home
# CMS release itself — Home CMS has no payment surface)
PAYMENT_PROVIDER=zibal
# ZIBAL_MERCHANT_ID=
# ZARINPAL_MERCHANT_ID=

# --- Web build arg (consumed by docker-compose.production.yml's
# `web.build.args`, NOT read at container runtime — Next.js inlines
# NEXT_PUBLIC_* at build time) — no code-level default; the build fails
# closed without this, deliberately, to avoid ever baking a staging URL
# into a production image by accident.
NEXT_PUBLIC_API_URL=https://api.biawin.ir/api/v1

# --- Admin build arg (Stage 5.22 pattern — same build-time-only rule as
# above; same backend API, different frontend) ------------------------------
NEXT_PUBLIC_ADMIN_API_URL=https://api.biawin.ir/api/v1
