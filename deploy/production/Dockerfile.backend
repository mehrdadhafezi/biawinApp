# Multi-stage build for @biawin/backend (NestJS) in a pnpm/Turborepo monorepo.
# Build context MUST be the repo root: docker build -f deploy/production/Dockerfile.backend .
#
# Design goals:
# - pnpm install runs ONLY at image build time, never at container start.
# - Final image runs `node dist/src/main.js` directly — no dev tooling in the hot path.
# - devDependencies (prisma CLI, ts-node) are kept in the final image on purpose,
#   so `prisma migrate deploy` / `prisma db seed` can be run as a one-off
#   `docker compose run` against this same image (see deploy/production/deploy.sh).
#   This mirrors deploy/staging/Dockerfile.backend deliberately — same
#   size-vs-simplicity tradeoff, kept identical between environments so the
#   image that was verified on staging is the same image production runs.

FROM node:20-alpine AS base
# Installed via npm, not `corepack enable` — corepack resolves the pnpm
# version from the root package.json's `packageManager` field, which isn't
# present in every stage here, so it falls back to fetching pnpm's latest
# major (bit us once: pnpm 11.x needs Node >=22, this image ships Node 20).
# A pinned global install sidesteps that resolution entirely.
RUN npm install -g pnpm@10.5.2
WORKDIR /workspace

# ---- deps: install only what @biawin/backend needs (+ its workspace deps) ----
FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc turbo.json ./
COPY backend/package.json ./backend/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/config/package.json ./packages/config/package.json
RUN pnpm install --frozen-lockfile --filter=@biawin/backend...

# ---- build: compile TypeScript + generate Prisma client ----
# (packages/config has no dependencies of its own — no node_modules to copy)
FROM base AS build
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc turbo.json ./
COPY --from=deps /workspace/node_modules ./node_modules
COPY --from=deps /workspace/backend/node_modules ./backend/node_modules
COPY --from=deps /workspace/packages/types/node_modules ./packages/types/node_modules
COPY backend ./backend
COPY packages/types ./packages/types
COPY packages/config ./packages/config
RUN pnpm --filter=@biawin/backend prisma:generate
RUN pnpm --filter=@biawin/backend build

# ---- runtime ----
FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /workspace/node_modules ./node_modules
COPY --from=build /workspace/backend/node_modules ./backend/node_modules
COPY --from=build /workspace/packages/types/node_modules ./packages/types/node_modules
COPY --from=build /workspace/backend/dist ./backend/dist
COPY --from=build /workspace/backend/package.json ./backend/package.json
COPY --from=build /workspace/backend/prisma ./backend/prisma
COPY --from=build /workspace/backend/prisma.config.ts ./backend/prisma.config.ts
# Stage 5.21's `seed-home-media.ts` reads the real, visually-approved static
# images straight from `apps/web/public/home/**` (the same files this
# script's local-dev runs upload from) — copied from the build context
# directly, not from an earlier stage (no earlier stage in this Dockerfile
# ever touches `apps/web`). Small (~17 webp files), and only needed for the
# one-off `docker compose run --rm backend ... seed-home-media.ts` step in
# deploy.sh, same rationale as keeping devDependencies in this image for
# `prisma db seed`.
COPY apps/web/public/home ./apps/web/public/home

EXPOSE 4000
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=6 \
  CMD wget -qO- http://127.0.0.1:4000/api/health || exit 1

CMD ["node", "backend/dist/src/main.js"]
