# Copy to deploy/staging/.env.staging on the SERVER ONLY. Never commit the
# real file — it is gitignored (see .gitignore's `.env*` / `!.env.example`
# rule). Fill in real random secrets on the server itself; this file only
# holds placeholders and structure.
#
# Generate strong random secrets with, e.g.:
#   openssl rand -base64 48

NODE_ENV=production
PORT=4000

# --- Database (internal Docker network: service name, NOT a host port) ------
# biawin-staging-postgres:5432 is only reachable from other containers on the
# biawin-staging Docker network — the host-side port for direct psql/DBeaver
# access from the server itself is 127.0.0.1:5433 (see docker-compose.staging.yml).
POSTGRES_USER=biawin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
POSTGRES_DB=biawin_staging
DATABASE_URL="postgresql://biawin:REPLACE_WITH_RANDOM_SECRET@postgres:5432/biawin_staging?schema=public"

# --- Redis --------------------------------------------------------------------
REDIS_URL="redis://redis:6379"

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_REFRESH_TTL_DAYS=30

OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

SIGNUP_TOKEN_TTL_SECONDS=600

# Staging-only OTP bypass (09121111111 / 123456) for QA without a real SMS
# provider. MUST be "false" (or removed) the moment this env file is reused
# as a template for real production — see docs/08-staging-deployment.md.
STAGING_TEST_AUTH=true

# --- Admin auth (Stage 5.16, docs/admin-architecture-decision-record.md) ----
# REQUIRED — the backend fails to boot without these two (no default,
# min 16 chars). Deliberately separate secrets from JWT_ACCESS_SECRET/
# JWT_REFRESH_SECRET above — never reuse the customer ones here.
ADMIN_JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET
ADMIN_JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_SECRET
ADMIN_JWT_ACCESS_TTL=10m
ADMIN_JWT_REFRESH_TTL_DAYS=7
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15

# First SUPER_ADMIN, created only by `prisma db seed` (which `deploy.sh` runs
# every deploy). Optional in the schema, but without these set, no admin
# account exists on this environment at all and Admin Portal login is
# impossible. Change the password immediately after first login.
ADMIN_SEED_EMAIL=admin@biawin.ir
ADMIN_SEED_PASSWORD=REPLACE_WITH_RANDOM_SECRET
ADMIN_SEED_FULL_NAME="Biawin Admin"

# --- Object Storage (MinIO) -------------------------------------------------
STORAGE_ENDPOINT="http://minio:9000"
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=biawin
STORAGE_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
MINIO_ROOT_USER=biawin
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_SECRET
STORAGE_BUCKET=biawin-staging
STORAGE_FORCE_PATH_STYLE=true

# --- Media Library (Stage 5.18) — optional, defaults to 5MB if unset --------
MEDIA_MAX_FILE_SIZE_BYTES=5242880

# --- Public asset base URL (Stage 5.21) -------------------------------------
# REQUIRED to be set correctly here — the code default (localhost:4000) is
# only correct for local dev. Every Home CMS image URL is built from this
# value; leaving it unset on staging would serve images pointing at
# "localhost" to real staging visitors, appearing broken in every browser.
PUBLIC_API_ORIGIN=https://api-staging.biawin.ir

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS="https://staging.biawin.ir"

# --- SMS provider — mock only on staging until a real account is credentialed
SMS_PROVIDER=mock

# --- Payment provider — architecture only; no real transactions without
# credentials supplied later by the project owner
PAYMENT_PROVIDER=zibal
# ZIBAL_MERCHANT_ID=
# ZARINPAL_MERCHANT_ID=

# --- Web build arg (consumed by docker-compose.staging.yml's `web.build.args`,
# NOT read at container runtime — Next.js inlines NEXT_PUBLIC_* at build time) --
NEXT_PUBLIC_API_URL=https://api-staging.biawin.ir/api/v1
